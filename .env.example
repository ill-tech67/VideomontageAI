# ============================================================
#  VideoTG — Telegram-бот для AI-монтажа видео
#  Скопируйте в .env и заполните под себя
# ============================================================

# --- Telegram -------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# ID администраторов через запятую (необязательно)
ADMIN_IDS=

# --- База данных ----------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/videotg.db
DATA_DIR=./data

# --- Шифрование ключей ---------------------------------------
# Любая длинная строка. Из неё выводится ключ Fernet.
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=

# --- Правообладатели ИИ (BYOK) --------------------------------
# Необязательно: если заданы, пользователь может работать без своего ключа.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# --- Рендеринг -----------------------------------------------
# Рендер-движок: local | docker | cloud
RENDER_MODE=local
# Команда запуска HyperFrames CLI
HYPERFRAMES_CLI=npx
# Закреплённая версия HyperFrames (пусто = latest)
HYPERFRAMES_VERSION=0.8.181
# Путь к современному ffmpeg (нужен фильтр setparams, ffmpeg >= 5)
FFMPEG_BINARY=
FFPROBE_BINARY=
# Проверять ffmpeg перед рендером
REQUIRE_MODERN_FFMPEG=true
# Параллельные рендеры
MAX_CONCURRENT_RENDERS=2
# Таймаут рендера, секунд
RENDER_TIMEOUT=1800

# --- HyperFrames Cloud (рендер без локального Chrome) --------
HYPERFRAMES_CLOUD_TOKEN=

# --- Политика и лимиты ---------------------------------------
# Версия согласия. При смене версии пользователям снова потребуется принять.
CONSENT_VERSION=2026-10-20
CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_LENGTH=4
# Максимум шагов агентного цикла за одну задачу
AGENT_MAX_STEPS=12
# Максимальный размер файла, который бот примет от пользователя, МБ
MAX_UPLOAD_MB=200

# --- Прочее ---------------------------------------------------
LOG_LEVEL=INFO
# Бот работает в режиме long polling (True) или webhook (False)
LONG_POLLING=true
# Секрет для проверки webhook-заголовка (X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=
WEBHOOK_URL=
