{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12",
    "node": "22"
  },
  "deploy": {
    "aptPackages": [
      "ffmpeg", "ca-certificates", "fonts-dejavu-core",
      "libnss3", "libatk1.0-0", "libatk-bridge2.0-0", "libcups2", "libdrm2",
      "libxkbcommon0", "libxcomposite1", "libxdamage1", "libxfixes3",
      "libxrandr2", "libgbm1", "libasound2t64", "libpango-1.0-0", "libcairo2"
    ],
    "variables": {
      "DATA_DIR": "/app/data",
      "DATABASE_URL": "sqlite+aiosqlite:////app/data/videotg.db",
      "RENDER_MODE": "local",
      "PYTHONUNBUFFERED": "1",
      "npm_config_cache": "/app/data/cache/npm",
      "XDG_CACHE_HOME": "/app/data/cache/xdg"
    },
    "startCommand": "python -m app"
  }
}
